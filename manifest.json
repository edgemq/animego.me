{
  "manifest_version": 3,
  "name": "AnimeGO Autoplay Next Episode",
  "version": "1.0.0",
  "description": "Автоматическое переключение на следующую серию при завершении видео на AnimeGO.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://ntfy.sh/*",
    "https://api.qrserver.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://animego.me/*",
        "*://*.animego.me/*",
        "*://animego.org/*",
        "*://*.animego.org/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["player.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
